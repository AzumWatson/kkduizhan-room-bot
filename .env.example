# NapCat / OneBot WS
NAPCAT_WS_URL=ws://127.0.0.1:3001/
NAPCAT_TOKEN=

# 必填：KK API token
KK_TOKEN=your_kk_token

# KK 接口基础地址（一般无需修改）
KK_ROOMS_ENDPOINT=https://kk-web-gateway.kkdzpt.com/platform-map-api/api/v3/map/w3_roomList
KK_CHANGELOGS_ENDPOINT=https://kk-web-gateway.kkdzpt.com/platform-map-api/api/v3/map/changelogs

# 默认 mapId（发送“房间信息”或“更新信息”时使用）
KK_DEFAULT_MAP_ID=12860

# 分群默认 mapId（可选）：群号:mapId;群号:mapId
# 例如：123456789:12860;987654321:10086
GROUP_DEFAULT_MAP_IDS=

# 监听群号（逗号分隔）
GROUP_IDS=123456789

# 触发词
# 兼容旧变量：TRIGGER_TEXT（等同 ROOM_INFO_TRIGGER_TEXT）
ROOM_INFO_TRIGGER_TEXT=房间信息
CHANGELOG_TRIGGER_TEXT=更新信息

# 频控
COOLDOWN_MS=5000

# 网络
FETCH_TIMEOUT_MS=10000
WS_RECONNECT_DELAY_MS=3000

# 房间查询 limit
KK_MAP_LIST_LIMIT=32
KK_ROOM_NAME_LIST_LIMIT=12

# 更新信息查询 limit（通常 1 即最新）
KK_CHANGELOG_LIMIT=1

# 渲染
MAX_ROWS=18
CANVAS_WIDTH=974
CHANGELOG_CANVAS_WIDTH=920
ERROR_CANVAS_WIDTH=860

# 日志
LOG_DIR=./logs
LOG_FILE=kkbot.log
